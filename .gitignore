# PlatformIO build output — regenerated by every build, never commit.
.pio/

# Python virtual environments.
#   .venv      — host tooling (test client, analysis scripts); see requirements.txt
#   .venv_pio  — PlatformIO toolchain, not a project dependency
.venv/
.venv_pio/
__pycache__/
*.pyc

# Local device configuration: WiFi credentials and device address.
# Copy ESP32_Auth_PIO/src/config.example.h to config.h and fill it in.
ESP32_Auth_PIO/src/config.h

# Generated benchmark datasets and charts — reproducible from a run.
# The README documenting the layout is tracked; the results themselves are not.
results/*
!results/README.md

# Runtime scratch from `make mock` / `make smoke-test`.
ESP32_Auth_PIO/mock.pid
ESP32_Auth_PIO/test_log.csv

# Generated report artefacts. report_content.py is the tracked source; the
# rendered documents are not. paper/logos/ and paper/figures/ ARE tracked —
# make_report_assets.py regenerates them, but they need no device or dataset.
paper/Final_Report.docx
paper/Final_Report.pdf
paper/Final_Report.tex
paper/*.aux
paper/*.log
paper/*.out
.~lock.*#

# Obsidian workspace state (docs/ is the vault; its notes ARE tracked).
.obsidian/workspace.json
.obsidian/cache
.native/
